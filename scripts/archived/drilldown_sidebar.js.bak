/**
 * T3Planet Docs: Drill-down sidebar
 * - Root view: show only top-level items (L1).
 * - Section view: show Back button + active section's sub-items only.
 */
(function () {
  'use strict';

  function getIndexHref() {
    var path = (window.location.pathname || '').replace(/^\//, '');
    var segs = path.split('/').filter(Boolean);
    // Read the Docs (and similar): /en/latest/... -> docs root is /en/latest/
    var isWeb = window.location.protocol === 'http:' || window.location.protocol === 'https:';
    if (isWeb && segs.length >= 3) {
      return '/' + segs[0] + '/' + segs[1] + '/';
    }
    if (segs.length <= 1) return 'index.html';
    var depth = segs.length - 1;
    return Array(depth + 1).join('../') + 'index.html';
  }

  function init() {
    var menu = document.querySelector('.wy-menu.wy-menu-vertical');
    if (!menu) return;

    var rootUl = menu.querySelector(':scope > ul');
    if (!rootUl) return;

    var atRoot = !document.querySelector('.wy-menu .toctree-l1.current');
    if (atRoot) {
      menu.setAttribute('data-drilldown', 'root');
      return;
    }

    menu.setAttribute('data-drilldown', 'section');

    var backHref = getIndexHref();
    var backEl = document.createElement('div');
    backEl.className = 'drilldown-back-wrap';
    backEl.innerHTML =
      '<a href="' + backHref + '" class="drilldown-back" aria-label="Back to main menu">' +
      '<span class="drilldown-back-icon" aria-hidden="true">←</span> Back to all docs' +
      '</a>';
    menu.insertBefore(backEl, rootUl);
  }

  /* Header: add "Give feedback" and "View Templates" buttons */
  function setupHeaderButtons() {
    var nav = document.querySelector('.rst-content > div[role="navigation"][aria-label="Page navigation"]');
    if (!nav) return;
    var ul = nav.querySelector('.wy-breadcrumbs');
    if (!ul) return;
    var existing = nav.querySelector('.t3-header-buttons');
    if (existing) return;

    var wrap = document.createElement('div');
    wrap.className = 't3-header-buttons';
    wrap.innerHTML =
      '<a href="https://t3planet.de/en/contact" class="t3-header-btn t3-header-btn-feedback" target="_blank" rel="noopener noreferrer">' +
      '<span class="fa fa-comment-o" aria-hidden="true"></span> Give feedback' +
      '</a>' +
      '<a href="https://t3planet.de/en/typo3-templates" class="t3-header-btn t3-header-btn-templates" target="_blank" rel="noopener noreferrer">' +
      'View Templates' +
      '</a>';
    nav.insertBefore(wrap, nav.querySelector('hr'));
  }

  /* Mobile: close menu when clicking the backdrop (dimmed content area) */
  function setupMobileBackdrop() {
    var wrap = document.querySelector('.wy-nav-content-wrap');
    if (!wrap) return;
    wrap.addEventListener('click', function (e) {
      if (!wrap.classList.contains('shift')) return;
      /* Don’t close if click was on the menu button (hamburger) */
      if (e.target.closest('[data-toggle="wy-nav-top"]')) return;
      var side = document.querySelector('.wy-nav-side');
      if (side) side.classList.remove('shift');
      wrap.classList.remove('shift');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      init();
      setupHeaderButtons();
      setupMobileBackdrop();
    });
  } else {
    init();
    setupHeaderButtons();
    setupMobileBackdrop();
  }
})();
